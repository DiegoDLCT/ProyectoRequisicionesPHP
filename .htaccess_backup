RewriteEngine On

# Redirigir todo al frontend index
RewriteCond %{REQUEST_URI} !^/frontend/
RewriteCond %{REQUEST_URI} !^/backend/
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteRule ^(.*)$ frontend/index.php [L,QSA]

# Proteger archivos del backend
<FilesMatch "\.(php|inc)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<Files ~ "^index\.php$">
    Order Allow,Deny
    Allow from all
</Files>